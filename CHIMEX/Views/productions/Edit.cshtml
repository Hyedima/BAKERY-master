﻿@model CHIMEX.Models.production

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Edit</h2>

<form action="@Url.Action("Edit","Productions")" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" class="form-control" name="id" value="@Model.id" required="" />
    <label>Product</label>
    <input type="text" readonly="" class="form-control" name="" value="@Model.stock.product.product_name" required="" />
    <label>No of bags</label>
    <input type="text" class="form-control" name="qty_bags" readonly="readonly" value="@Model.qty_bags" required="" />
    <label>Qty per bag</label>
    <input type="text" class="form-control" name="qty_items" value="@Model.qty_items" required="" />
    <br />
    <button type="submit" class="btn btn-success">Save Changes</button>
</form>

<div>
    @Html.ActionLink("Back to List", "Index")
</div>