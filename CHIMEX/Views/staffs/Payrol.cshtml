@model CHIMEX.Models.staff

@{
    ViewBag.Title = "Payrol";
    Layout = "~/Views/Shared/_Layout.cshtml";
    CHIMEX.Models.chimexerpEntities db = new CHIMEX.Models.chimexerpEntities();
    decimal totalSalaries = 0;
    decimal totalBonus = 0;
    decimal totalDeductions = 0;
    int sn = 0;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="card-header py-3">
                    <center>
                        <h4 class="m-0 font-weight-bold text-primary">
                            Staff Salaries
                        </h4>
                    </center>
                </div>
                <br />
                <br />
                <br />
                 
                <div class="panel-body" id="rpt">
                    <button href="#" class="btn btn-warning pull-right" onclick="printDiv('rpt')"><span class="fa fa-print"></span>Print</button>
                    <a href="#" data-toggle="modal" data-target="#payRoll" class="btn btn-success">Create New Payroll</a>
                    <br />   <br />
                    <div class="card-header py-3">
                        <center>
                            <h4 class="m-0 font-weight-bold text-primary">
                                Name: @Model.name <br />
                                Phone: @Model.phone <br />
                                Address: @Model.address
                            </h4>
                        </center>
                    </div>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    SN
                                </th>
                                <th>Title</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var item in db.salarybatches.Where(p=>p.staffid == Model.id).OrderByDescending(p=>p.insertdate).ToList())
                                {
                                                    sn++;
                                    <tr>
                                        <td>@sn</td>
                                        <td>
                                            <a href="@Url.Action("PrepareSalary","Staffs", new {id = item.id })">
                                                @item.notes 
                                            </a>
                                        </td>
                                        <td>@item.insertdate</td>
                                    </tr>
                                }
                        </tbody>
                    </table>
                    
                </div>
                    </div>
                    <!-- END PANEL WITH CONTROL CLASSES -->
                </div>
            </div>
        </div>
        <!--<button type="button" class="btn btn-info btn-sm" data-toggle="modal" data-target="#newstock">Add product to Stock</button>-->
        <!-- Modal -->
        <div id="payRoll" class="modal fade" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Preparing Payroll</h4>
                    </div>
                    <div class="modal-body">
                        <form method="post" action="@Url.Action("postPayRollss","staffs")">
                            <input type="hidden" class="form-control" name="staffid" value="@Model.id" />
                            <label>Title ({Month} and {Year} Salary)</label>
                            <input type="text" class="form-control" name="description" value="@DateTime.Now.Month @DateTime.Now.Year Salary" />
                            <button class="btn btn-sm btn-success">Submit</button>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    </div>
                </div>

            </div>
        </div>
